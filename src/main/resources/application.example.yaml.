spring:
  datasource:
    url: jdbc:mysql://{host}:{port}/{schema}?autoReconnect=true
    username: {db_username}
    password: {db_password}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    generate-ddl: true
    show-sql: true
    open-in-view: true
  oauth:
    uri: {oauth-uri}
    id: {id}
    secret: {secret}
    redirect-uri: {redirect-uri}
  mail:
    url: {url}
    api-key: {api-key}
ranking:
  uri: {ranking-uri}
cors:
  allowed-origins: {allowed-origins}
server:
  servlet:
    context-path: /api/v1
  port: 8082
